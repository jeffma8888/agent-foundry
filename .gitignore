# Runtime artifacts produced by each product team (per-run noise, not source)
products/*/state/
products/*/NIGHT_LOG.md
products/*/STATUS_REPORT.md
products/*/LEARNINGS.md
products/*/STATUS_REPORT.md
DISPATCH_LOG.md
STOP
products/*/STOP
# A transient post-release hotfix flag (raised on a BROKEN clean-room verify)
# is runtime state, not source — never let it leak into a commit.
products/*/HOTFIX_NEEDED.md

# The live dispatcher config (copy of the .example) is machine-local
foundry.config.json

# Python / uv
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local-only promotion / scratch notes
PROMOTION.md
